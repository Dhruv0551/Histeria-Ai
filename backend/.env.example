# ==============================================================================
# Histeria-AI Environment Configuration
# ==============================================================================

# [REQUIRED] Groq API Key
# Sign up and generate a free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# [REQUIRED] Tavily Search API Key
# Used for real-time web search and citation gathering.
# Get a free key at: https://tavily.com
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# [OPTIONAL] Groq Model Configuration
# Supported models on Groq include:
#   - openai/gpt-oss-120b (High-capability reasoning model - Recommended for research)
#   - openai/gpt-oss-20b  (Fast and lightweight - Recommended for classifier + synthesizer)
#   - qwen/qwen3.8-27b
# Note: Retired/decommissioned models (e.g. llama-3.3-70b-versatile) may return 404.
GROQ_MODEL=openai/gpt-oss-120b

# Granular model overrides (optional):
# Fast classification model to determine whether research tools are needed
GROQ_CLASSIFIER_MODEL=openai/gpt-oss-20b
# Agent model for multi-step ReAct research and tool usage
GROQ_RESEARCH_MODEL=openai/gpt-oss-120b
# Formatter model for synthesizing final Pydantic JSON reports
# NOTE: Switched to 20b — formatting is a simple task, 120b is overkill and costly
GROQ_SYNTHESIZER_MODEL=openai/gpt-oss-20b
